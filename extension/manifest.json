{
  "manifest_version": 3,
  "name": "Personalize Sendi",
  "version": "0.2.1",
  "description": "Temas personalizados e assistente de IA (melhorar, sugerir, motivo) para o Sendi.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "personalize-sendi@personalizenato.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["personalCommunications"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*.sendi.chat/*"],
      "js": ["src/sounds.js", "src/sound-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.sendi.chat/*"],
      "js": ["src/selectors.js", "src/icons.js", "src/storage.js", "src/theme.js", "src/clean.js", "src/ai.js", "src/clientlink.js", "src/sound.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Personalize Sendi",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
